---
const items = [
	{ title: 'Drag or double-click', text: 'Pick your trigger: drag, double-click, or both. The text is on your clipboard before you let go.' },
	{ title: 'Works in every app', text: 'If you can select it, Snipy copies it.' },
	{ title: 'Lives in your tray', text: 'Always on, never in the way.' },
	{ title: 'One switch', text: 'Toggle auto-copy on or off from the tray panel.' },
	{ title: 'Your minimum', text: 'Ignore accidental selections: 1, 2, 3 or 5 characters.' },
];
---

<section id="features" class="mx-auto max-w-3xl px-6 py-16">
	<h2 class="reveal text-2xl font-semibold tracking-tight">Features</h2>
	<dl class="mt-8 divide-y divide-line border-y border-line">
		{items.map((f, i) => (
			<div style={`--d:${i * 70}ms`} class="reveal from-left lift grid gap-1 py-5 md:grid-cols-[14rem_1fr] md:gap-8">
				<dt class="font-medium">{f.title}</dt>
				<dd class="text-muted">{f.text}</dd>
			</div>
		))}
	</dl>
</section>
