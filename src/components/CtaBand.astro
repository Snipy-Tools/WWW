---
import DownloadButton from './DownloadButton.astro';
---

<section class="px-6 py-24">
	<div class="card relative mx-auto max-w-5xl overflow-hidden px-6 py-20 text-center">
		<div class="pointer-events-none absolute left-1/2 top-full h-72 w-150 -translate-x-1/2 -translate-y-1/2 rounded-full bg-mint/25 blur-[100px]"></div>
		<img src="/snipy.svg" alt="" width="64" height="60" class="relative mx-auto mb-6" />
		<h2 class="gradient-text relative font-display text-4xl font-bold md:text-5xl">Stop pressing Ctrl+C.</h2>
		<div class="relative mt-8"><DownloadButton /></div>
	</div>
</section>
