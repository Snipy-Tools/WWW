---
import DownloadButton from './DownloadButton.astro';
---

<section class="relative overflow-hidden px-6 pb-24 pt-40 text-center">
	<div class="grid-bg pointer-events-none absolute inset-0"></div>
	<div class="pointer-events-none absolute left-1/2 top-0 h-130 w-205 -translate-x-1/2 rounded-full bg-mint/20 blur-[140px]"></div>

	<div class="relative mx-auto max-w-4xl">
		<img src="/snipy.svg" alt="Snipy mascot" width="96" height="90" class="float mx-auto mb-8 drop-shadow-[0_0_40px_rgb(61_214_176/0.6)]" />
		<p class="mx-auto mb-6 w-fit rounded-full border border-line bg-white/5 px-3 py-1 font-mono text-xs text-muted">
			<span class="text-mint">●</span> Now available for Windows
		</p>
		<h1 class="gradient-text font-display text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">
			Highlight it.<br /><span class="mint-text">It's copied.</span>
		</h1>
		<p class="mx-auto mt-6 max-w-xl text-lg text-muted">
			Snipy lives in your tray and copies any text you select, in every app. No more Ctrl+C.
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			<DownloadButton />
			<a href="#how" class="rounded-full border border-line px-6 py-3 text-sm font-medium text-white transition hover:bg-white/5">
				See how it works
			</a>
		</div>
	</div>
</section>
