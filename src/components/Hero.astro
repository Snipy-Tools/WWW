---
import DownloadButton from './DownloadButton.astro';
---

<section class="px-6 pb-20 pt-36">
	<div class="mx-auto max-w-3xl">
		<img src="/snipy.svg" alt="Snipy mascot" width="72" height="68" class="mascot mb-8" />
		<h1 style="--d:150ms" class="rise text-4xl font-semibold tracking-tight md:text-5xl">Highlight it. <span class="hl">It's copied.</span></h1>
		<p style="--d:300ms" class="rise mt-5 max-w-xl text-lg text-muted">
			Snipy lives in your tray and copies any text you select, in every app. No more Ctrl+C.
		</p>
		<div style="--d:450ms" class="rise mt-8 flex flex-wrap items-center gap-4">
			<DownloadButton />
			<a href="#how" class="text-sm text-muted underline underline-offset-4 hover:text-white">See how it works</a>
		</div>
		<p style="--d:600ms" class="rise mt-4 text-sm text-muted">Windows only.</p>
	</div>
</section>
