---
interface Props {
	class?: string;
	label?: string;
}
const { class: className = '', label = 'Download for Windows' } = Astro.props;
---

<a
	href="https://github.com/Snipy-Tools/Snipy/releases/latest/download/snipy-Windows-Setup.exe"
	class:list={[
		'btn inline-flex items-center gap-2 rounded-md bg-mint px-5 py-2.5 text-sm font-medium text-black hover:bg-white',
		className,
	]}
>
	{label}
</a>
