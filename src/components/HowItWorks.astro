---
const steps = [
	{ title: 'Highlight text', text: 'Drag across it or double-click a word, in any app.' },
	{ title: "It's copied", text: 'A small toast confirms. Nothing else to press.' },
	{ title: 'Paste anywhere', text: 'Ctrl+V as usual. Your clipboard is already ready.' },
];
---

<section id="how" class="mx-auto max-w-3xl px-6 py-16">
	<h2 class="reveal text-2xl font-semibold tracking-tight">How it works</h2>
	<ol class="mt-8 list-decimal space-y-4 pl-5 marker:text-muted">
		{steps.map((s, i) => (
			<li style={`--d:${i * 150}ms`} class="reveal pop pl-2">
				<span class="font-medium">{s.title}.</span>
				<span class="text-muted"> {s.text}</span>
			</li>
		))}
	</ol>
</section>
