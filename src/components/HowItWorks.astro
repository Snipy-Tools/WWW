---
const steps = [
	{ n: '01', title: 'Highlight text', text: 'Drag across it or double-click a word, in any app.' },
	{ n: '02', title: "It's copied", text: 'A small toast confirms. Nothing else to press.' },
	{ n: '03', title: 'Paste anywhere', text: 'Ctrl+V as usual. Your clipboard is already ready.' },
];
---

<section id="how" class="mx-auto max-w-6xl px-6 py-24">
	<h2 class="gradient-text mb-16 text-center font-display text-4xl font-bold tracking-tight md:text-5xl">
		Three steps. Actually, two.
	</h2>
	<ol class="grid gap-4 md:grid-cols-3">
		{steps.map((s) => (
			<li class="card p-8">
				<span class="font-mono text-sm text-mint">{s.n}</span>
				<h3 class="mt-4 font-display text-2xl font-bold">{s.title}</h3>
				<p class="mt-2 text-muted">{s.text}</p>
			</li>
		))}
	</ol>
</section>
